import fs from 'fs/promises';
import path from 'path';

const DATA_DIR = path.join(process.cwd(), 'data');
const SESSIONS_FILE = path.join(DATA_DIR, 'sessions.json');
const ATTENDANCE_FILE = path.join(DATA_DIR, 'attendance.json');
const SETTINGS_FILE = path.join(DATA_DIR, 'settings.json');
const SECTIONS_FILE = path.join(DATA_DIR, 'sections.json');
const TIMETABLE_FILE = path.join(DATA_DIR, 'timetable.json');
const DISPUTES_FILE = path.join(DATA_DIR, 'disputes.json');

// Ensure data directory exists
async function ensureDataDir() {
    try {
        await fs.access(DATA_DIR);
    } catch {
        await fs.mkdir(DATA_DIR, { recursive: true });
    }
}

// Generic helper to read/write JSON
async function readJson<T>(file: string, defaultValue: T): Promise<T> {
    try {
        await ensureDataDir();
        const data = await fs.readFile(file, 'utf-8');
        return JSON.parse(data);
    } catch (error) {
        return defaultValue;
    }
}

async function writeJson<T>(file: string, data: T): Promise<void> {
    await ensureDataDir();
    await fs.writeFile(file, JSON.stringify(data, null, 2));
}

// Types
export interface Section {
    id: string;
    name: string; // e.g., "Section A", "CS-101"
    studentIds: string[];
    createdAt: number;
}

export interface TimeSlot {
    id: string;
    day: 'Monday' | 'Tuesday' | 'Wednesday' | 'Thursday' | 'Friday' | 'Saturday' | 'Sunday';
    startTime: string; // e.g., "09:00"
    endTime: string;   // e.g., "10:00"
    subject: string;
    teacherId: string;
    sectionId: string;
}

export interface Session {
    id: string;
    subject: string;
    teacherId: string;
    sectionId: string;
    slotId?: string; // Reference to timetable slot
    startTime: number;
    endTime?: number;
    active: boolean;
    qrCode: string;
    locked: boolean; // Auto-locked after closing
    unlockedByAdmin?: boolean; // Admin can temporarily unlock
}

export interface Attendance {
    id: string;
    sessionId: string;
    studentId: string;
    studentName: string;
    timestamp: number;
    status: 'present' | 'absent';
    photo?: string; // Base64 encoded photo
    markedBy: 'student' | 'teacher'; // Who marked it
    location?: {
        latitude: number;
        longitude: number;
    };
}

export interface Dispute {
    id: string;
    sessionId: string;
    studentId: string;
    studentName: string;
    reason: string;
    status: 'pending' | 'approved' | 'rejected';
    createdAt: number;
    resolvedAt?: number;
    resolvedBy?: string; // Admin ID
}

export interface Settings {
    attendanceEnabled: boolean;
    qrRefreshInterval: number; // in milliseconds (default 3000-4000)
    disputeGracePeriod: number; // in milliseconds (default 2 days)
}

// Sessions API
export async function getSessions(): Promise<Session[]> {
    return readJson<Session[]>(SESSIONS_FILE, []);
}

export async function saveSession(session: Session): Promise<void> {
    const sessions = await getSessions();
    const index = sessions.findIndex(s => s.id === session.id);
    if (index >= 0) {
        sessions[index] = session;
    } else {
        sessions.push(session);
    }
    await writeJson(SESSIONS_FILE, sessions);
}

export async function getActiveSession(teacherId?: string): Promise<Session | null> {
    const sessions = await getSessions();
    return sessions.find(s => s.active && (!teacherId || s.teacherId === teacherId)) || null;
}

// Attendance API
export async function getAttendance(sessionId?: string): Promise<Attendance[]> {
    const attendance = await readJson<Attendance[]>(ATTENDANCE_FILE, []);
    if (sessionId) {
        return attendance.filter(a => a.sessionId === sessionId);
    }
    return attendance;
}

export async function markAttendance(record: Attendance): Promise<void> {
    const attendance = await getAttendance();
    // Check for duplicate
    const exists = attendance.find(
        a => a.sessionId === record.sessionId && a.studentId === record.studentId
    );
    if (!exists) {
        attendance.push(record);
        await writeJson(ATTENDANCE_FILE, attendance);
    }
}

export async function updateAttendance(recordId: string, updates: Partial<Attendance>): Promise<boolean> {
    const attendance = await getAttendance();
    const index = attendance.findIndex(a => a.id === recordId);
    if (index === -1) return false;
    
    attendance[index] = { ...attendance[index], ...updates };
    await writeJson(ATTENDANCE_FILE, attendance);
    return true;
}

export async function deleteAttendance(recordId: string): Promise<boolean> {
    const attendance = await getAttendance();
    const filtered = attendance.filter(a => a.id !== recordId);
    if (filtered.length === attendance.length) return false;
    
    await writeJson(ATTENDANCE_FILE, filtered);
    return true;
}

// Sections API
export async function getSections(): Promise<Section[]> {
    return readJson<Section[]>(SECTIONS_FILE, []);
}

export async function saveSection(section: Section): Promise<void> {
    const sections = await getSections();
    const index = sections.findIndex(s => s.id === section.id);
    if (index >= 0) {
        sections[index] = section;
    } else {
        sections.push(section);
    }
    await writeJson(SECTIONS_FILE, sections);
}

export async function deleteSection(sectionId: string): Promise<boolean> {
    const sections = await getSections();
    const filtered = sections.filter(s => s.id !== sectionId);
    if (filtered.length === sections.length) return false;
    await writeJson(SECTIONS_FILE, filtered);
    return true;
}

// Timetable API
export async function getTimeSlots(): Promise<TimeSlot[]> {
    return readJson<TimeSlot[]>(TIMETABLE_FILE, []);
}

export async function saveTimeSlot(slot: TimeSlot): Promise<void> {
    const slots = await getTimeSlots();
    const index = slots.findIndex(s => s.id === slot.id);
    if (index >= 0) {
        slots[index] = slot;
    } else {
        slots.push(slot);
    }
    await writeJson(TIMETABLE_FILE, slots);
}

export async function deleteTimeSlot(slotId: string): Promise<boolean> {
    const slots = await getTimeSlots();
    const filtered = slots.filter(s => s.id !== slotId);
    if (filtered.length === slots.length) return false;
    await writeJson(TIMETABLE_FILE, filtered);
    return true;
}

export async function getSlotsBySection(sectionId: string): Promise<TimeSlot[]> {
    const slots = await getTimeSlots();
    return slots.filter(s => s.sectionId === sectionId);
}

export async function getSlotsByTeacher(teacherId: string): Promise<TimeSlot[]> {
    const slots = await getTimeSlots();
    return slots.filter(s => s.teacherId === teacherId);
}

// Disputes API
export async function getDisputes(): Promise<Dispute[]> {
    return readJson<Dispute[]>(DISPUTES_FILE, []);
}

export async function saveDispute(dispute: Dispute): Promise<void> {
    const disputes = await getDisputes();
    const index = disputes.findIndex(d => d.id === dispute.id);
    if (index >= 0) {
        disputes[index] = dispute;
    } else {
        disputes.push(dispute);
    }
    await writeJson(DISPUTES_FILE, disputes);
}

export async function getStudentDisputes(studentId: string): Promise<Dispute[]> {
    const disputes = await getDisputes();
    return disputes.filter(d => d.studentId === studentId);
}

export async function getPendingDisputes(): Promise<Dispute[]> {
    const disputes = await getDisputes();
    return disputes.filter(d => d.status === 'pending');
}

// Check if attendance can be edited
export async function canEditAttendance(sessionId: string): Promise<boolean> {
    const sessions = await getSessions();
    const session = sessions.find(s => s.id === sessionId);
    
    if (!session) return false;
    
    // Can edit if:
    // 1. Session is not locked
    // 2. Session is locked but unlocked by admin
    return !session.locked || session.unlockedByAdmin === true;
}

// Settings API
export async function getSettings(): Promise<Settings> {
    return readJson<Settings>(SETTINGS_FILE, { 
        attendanceEnabled: true,
        qrRefreshInterval: 3000,
        disputeGracePeriod: 2 * 24 * 60 * 60 * 1000 // 2 days
    });
}

export async function updateSettings(settings: Settings): Promise<void> {
    await writeJson(SETTINGS_FILE, settings);
}
